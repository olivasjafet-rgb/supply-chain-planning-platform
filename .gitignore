# Generated by a run -- reproducible with `python run_simulation.py`.
# Kept out of version control so the repo stays reviewable.
outputs/

# data/warehouse/ IS tracked, deliberately. It is generated by
# data/generate_dataset.py from a fixed seed, so it is reproducible rather than
# precious -- but committing it (280 KB) means the repo runs straight after a
# clone and the simulated data is browsable without executing anything.

